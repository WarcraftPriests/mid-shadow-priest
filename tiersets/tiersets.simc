priest="Base"
level=90
role=spell
position=back
spec=shadow
talents=${talents}

set_bonus=midnight_season_1_2pc=0/midnight_season_1_4pc=0/midnight_season_2_2pc=0/midnight_season_2_4pc=0

${apl}

head=${gear.head},gem_id=${gems.meta},enchant=${enchants.head}
neck=${gear.neck},gem_id=${gems.peridot}/${gems.garnet}
shoulders=${gear.shoulders}
back=${gear.back}
chest=${gear.chest},enchant=${enchants.chest}
wrists=${gear.wrists},gem_id=${gems.amethyst}
hands=${gear.hands}
waist=${gear.waist},gem_id=${gems.lapis}
legs=${gear.legs},enchant=${enchants.legs}
feet=${gear.feet}
finger1=${gear.finger1},enchant=${enchants.ring},gem_id=${gems.main}/${gems.main}
finger2=${gear.finger2},enchant=${enchants.ring},gem_id=${gems.main}/${gems.main}
trinket1=${gear.trinket1}
trinket2=${gear.trinket2}
main_hand=${gear.main_hand},enchant=${enchants.main_hand}
${gear.off_hand}

profileset."MID1-2-set"+=set_bonus=midnight_season_1_2pc=1
profileset."MID1-2_4-set"+=set_bonus=midnight_season_1_2pc=1/midnight_season_1_4pc=1

profileset."MID2-2-set"+=set_bonus=midnight_season_2_2pc=1
profileset."MID2-2_4-set"+=set_bonus=midnight_season_2_2pc=1/midnight_season_2_4pc=1