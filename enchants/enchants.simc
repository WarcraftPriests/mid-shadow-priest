priest="Base"
level=90
role=spell
position=back
spec=shadow
talents=${talents}
spec_talents+=/s1264096:1/s1264104:2/s1264107:1

${apl}

head=${gear.head},gem_id=${gems.meta}
neck=${gear.neck},gem_id=${gems.peridot}/${gems.garnet}
shoulders=${gear.shoulders}
back=${gear.back}
chest=${gear.chest}
wrists=${gear.wrists},gem_id=${gems.amethyst}
hands=${gear.hands}
waist=${gear.waist},gem_id=${gems.lapis}
legs=${gear.legs}
feet=${gear.feet}
finger1=${gear.finger1},gem_id=${gems.main}/${gems.main}
finger2=${gear.finger2},gem_id=${gems.main}/${gems.main}
trinket1=${gear.trinket1}
trinket2=${gear.trinket2}
main_hand=${gear.main_hand}
${gear.off_hand}

temporary_enchant=disabled

# Temporary Enchants - Weapon
profileset."Temp_Weapon_Smugglers_Enchanted_Edge_1"+=temporary_enchant=main_hand:smugglers_enchanted_edge_1
profileset."Temp_Weapon_Smugglers_Enchanted_Edge_2"+=temporary_enchant=main_hand:smugglers_enchanted_edge_2

profileset."Temp_Weapon_Thalassian_Phoenix_Oil_1"+=temporary_enchant=main_hand:thalassian_phoenix_oil_1
profileset."Temp_Weapon_Thalassian_Phoenix_Oil_2"+=temporary_enchant=main_hand:thalassian_phoenix_oil_2

# Legs
profileset."Legs_Bright_Linen_Spellthread_1"+=legs=${gear.legs},enchant=bright_linen_spellthread_1
profileset."Legs_Bright_Linen_Spellthread_2"+=legs=${gear.legs},enchant=bright_linen_spellthread_2

profileset."Legs_Arcanoweave_Spellthread_1"+=legs=${gear.legs},enchant=arcanoweave_spellthread_1
profileset."Legs_Arcanoweave_Spellthread_2"+=legs=${gear.legs},enchant=arcanoweave_spellthread_2

profileset."Legs_Sunfire_Silk_Spellthread_1"+=legs=${gear.legs},enchant=sunfire_silk_spellthread_1
profileset."Legs_Sunfire_Silk_Spellthread_2"+=legs=${gear.legs},enchant=sunfire_silk_spellthread_2

# Weapons
