priest="Base"
level=90
role=spell
position=back
spec=shadow
talents=${talents}

${apl}

head=${gear.head},gem_id=${gems.meta}
neck=${gear.neck},gem_id=${gems.peridot}/${gems.garnet}
shoulders=${gear.shoulders}
back=${gear.back}
chest=${gear.chest}
wrists=${gear.wrists},gem_id=${gems.amethyst}
hands=${gear.hands}
waist=${gear.waist},gem_id=${gems.lapis}
legs=${gear.legs}
feet=${gear.feet}
finger1=${gear.finger1},gem_id=${gems.main}/${gems.main}
finger2=${gear.finger2},gem_id=${gems.main}/${gems.main}
trinket1=${gear.trinket1}
trinket2=${gear.trinket2}
main_hand=${gear.main_hand}
${gear.off_hand}

temporary_enchant=disabled

# Temporary Enchants - Weapon
profileset."Temp_Weapon_Smugglers_Enchanted_Edge_1"+=temporary_enchant=main_hand:smugglers_enchanted_edge_1
profileset."Temp_Weapon_Smugglers_Enchanted_Edge_2"+=temporary_enchant=main_hand:smugglers_enchanted_edge_2

profileset."Temp_Weapon_Thalassian_Phoenix_Oil_1"+=temporary_enchant=main_hand:thalassian_phoenix_oil_1
profileset."Temp_Weapon_Thalassian_Phoenix_Oil_2"+=temporary_enchant=main_hand:thalassian_phoenix_oil_2

# Legs
profileset."Legs_Arcanoweave_Spellthread_1"+=legs=${gear.legs},enchant=arcanoweave_spellthread_1
profileset."Legs_Arcanoweave_Spellthread_2"+=legs=${gear.legs},enchant=arcanoweave_spellthread_2

profileset."Legs_Sunfire_Silk_Spellthread_1"+=legs=${gear.legs},enchant=sunfire_silk_spellthread_1
profileset."Legs_Sunfire_Silk_Spellthread_2"+=legs=${gear.legs},enchant=sunfire_silk_spellthread_2

# Weapons
## Primary Stat Proc
profileset."Weapon_Acuity_of_the_Rendorei_1"+=main_hand=${gear.main_hand},enchant=acuity_of_the_rendorei_1
profileset."Weapon_Acuity_of_the_Rendorei_2"+=main_hand=${gear.main_hand},enchant=acuity_of_the_rendorei_2

## Mastery Proc
profileset."Weapon_Arcane_Mastery_1"+=main_hand=${gear.main_hand},enchant=arcane_mastery_1
profileset."Weapon_Arcane_Mastery_2"+=main_hand=${gear.main_hand},enchant=arcane_mastery_2

## Haste Proc
profileset."Weapon_Berserkers_Rage_1"+=main_hand=${gear.main_hand},enchant=berserkers_rage_1
profileset."Weapon_Berserkers_Rage_2"+=main_hand=${gear.main_hand},enchant=berserkers_rage_2

## Crit Proc
profileset."Weapon_Janalais_Precision_1"+=main_hand=${gear.main_hand},enchant=janalais_precision_1
profileset."Weapon_Janalais_Precision_2"+=main_hand=${gear.main_hand},enchant=janalais_precision_2

## Vers Proc
profileset."Weapon_Worldsoul_Tenacity_1"+=main_hand=${gear.main_hand},enchant=worldsoul_tenacity_1
profileset."Weapon_Worldsoul_Tenacity_2"+=main_hand=${gear.main_hand},enchant=worldsoul_tenacity_2

## AoE Damage Proc
profileset."Weapon_Flames_of_the_Sindorei_1"+=main_hand=${gear.main_hand},enchant=flames_of_the_sindorei_1
profileset."Weapon_Flames_of_the_Sindorei_2"+=main_hand=${gear.main_hand},enchant=flames_of_the_sindorei_2

## Bleed Damage Proc
profileset."Weapon_Strength_of_Halazzi_1"+=main_hand=${gear.main_hand},enchant=strength_of_halazzi_1
profileset."Weapon_Strength_of_Halazzi_2"+=main_hand=${gear.main_hand},enchant=strength_of_halazzi_2

# Chest
## Intellect + Mana
profileset."Chest_Mark_of_the_Magister_1"+=chest=${gear.chest},enchant=mark_of_the_magister_1
profileset."Chest_Mark_of_the_Magister_2"+=chest=${gear.chest},enchant=mark_of_the_magister_2

## Primary Stat
profileset."Chest_Mark_of_the_Worldsoul_1"+=chest=${gear.chest},enchant=mark_of_the_worldsoul_1
profileset."Chest_Mark_of_the_Worldsoul_2"+=chest=${gear.chest},enchant=mark_of_the_worldsoul_2

# Ring

## % crit strike effectiveness
profileset."Ring_Eyes_of_the_Eagle_1"+=finger1=${gear.finger1},enchant=eyes_of_the_eagle_1,gem_id=${gems.main}/${gems.main}
profileset."Ring_Eyes_of_the_Eagle_2"+=finger1=${gear.finger1},enchant=eyes_of_the_eagle_2,gem_id=${gems.main}/${gems.main}

