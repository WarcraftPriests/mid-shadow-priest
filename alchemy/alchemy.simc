priest="Base"
level=90
role=spell
position=back
spec=shadow
talents=${talents}

${apl}

head=${gear.head},gem_id=${gems.meta},enchant=${enchants.head}
neck=${gear.neck},gem_id=${gems.peridot}/${gems.garnet}
shoulders=${gear.shoulders}
back=${gear.back}
chest=${gear.chest},enchant=${enchants.chest}
wrists=${gear.wrists},gem_id=${gems.amethyst}
hands=${gear.hands}
waist=${gear.waist},gem_id=${gems.lapis}
legs=${gear.legs},enchant=${enchants.legs}
feet=${gear.feet}
finger1=${gear.finger1},enchant=${enchants.ring},gem_id=${gems.main}/${gems.main}
finger2=${gear.finger2},enchant=${enchants.ring},gem_id=${gems.main}/${gems.main}
trinket1=${gear.trinket1}
trinket2=${gear.trinket2}
main_hand=${gear.main_hand},enchant=${enchants.main_hand}
${gear.off_hand}

potion=disabled
flask=disabled

# Flasks/Phials
## Crit
profileset."Flask_of_the_Shattered_Sun_1"+=flask=flask_of_the_shattered_sun_1
profileset."Flask_of_the_Shattered_Sun_2"+=flask=flask_of_the_shattered_sun_2

## Mastery
profileset."Flask_of_the_Magisters_1"+=flask=flask_of_the_magisters_1
profileset."Flask_of_the_Magisters_2"+=flask=flask_of_the_magisters_2

## Haste
profileset."Flask_of_the_Blood_Knights_1"+=flask=flask_of_the_blood_knights_1
profileset."Flask_of_the_Blood_Knights_2"+=flask=flask_of_the_blood_knights_2

## Vers
profileset."Flask_of_Thalassian_Resistance_1"+=flask=flask_of_thalassian_resistance_1
profileset."Flask_of_Thalassian_Resistance_2"+=flask=flask_of_thalassian_resistance_2

# Potions
profileset."Draught_of_Rampant_Abandon_1"+=potion=draught_of_rampant_abandon_1
profileset."Draught_of_Rampant_Abandon_2"+=potion=draught_of_rampant_abandon_2

profileset."Lights_Potential_1"+=potion=lights_potential_1
profileset."Lights_Potential_2"+=potion=lights_potential_2

profileset."Potion_of_Recklessness_1"+=potion=potion_of_recklessness_1
profileset."Potion_of_Recklessness_2"+=potion=potion_of_recklessness_2

profileset."Potion_of_Zealotry_1"+=potion=potion_of_zealotry_1
profileset."Potion_of_Zealotry_2"+=potion=potion_of_zealotry_2