priest="Base"
level=90
role=spell
position=back
spec=shadow
talents=${talents}

${apl}

head=${gear.head},gem_id=${gems.meta},enchant=${enchants.head}
neck=${gear.neck},gem_id=${gems.emerald}/${gems.ruby}
shoulders=${gear.shoulders}
back=${gear.back}
chest=${gear.chest},enchant=${enchants.chest}
wrists=${gear.wrists},gem_id=${gems.onyx}
hands=${gear.hands}
waist=${gear.waist},gem_id=${gems.sapphire}
legs=${gear.legs},enchant=${enchants.legs}
feet=${gear.feet}
finger1=${gear.finger1},enchant=${enchants.ring},gem_id=${gems.main}/${gems.main}
finger2=${gear.finger2},enchant=${enchants.ring},gem_id=${gems.main}/${gems.main}
trinket1=${gear.trinket1}
trinket2=${gear.trinket2}
main_hand=${gear.main_hand},enchant=${enchants.main_hand}
${gear.off_hand}

potion=disabled
flask=disabled

# Flasks/Phials
profileset."Flask_of_Alchemical_Chaos_1"+=flask=flask_of_alchemical_chaos_1
profileset."Flask_of_Alchemical_Chaos_2"+=flask=flask_of_alchemical_chaos_2

profileset."Midnight_Critical_Strike_Flask_1"+=flask=midnight_critical_strike_flask_1
profileset."Midnight_Critical_Strike_Flask_2"+=flask=midnight_critical_strike_flask_2

profileset."Midnight_Mastery_Flask_1"+=flask=midnight_mastery_flask_1
profileset."Midnight_Mastery_Flask_2"+=flask=midnight_mastery_flask_2

profileset."Midnight_Haste_Flask_1"+=flask=midnight_haste_flask_1
profileset."Midnight_Haste_Flask_2"+=flask=midnight_haste_flask_2

profileset."Midnight_Versatility_Flask_1"+=flask=midnight_versatility_flask_1
profileset."Midnight_Versatility_Flask_2"+=flask=midnight_versatility_flask_2

# Potions
profileset."Draught_of_Rampant_Abandon_1"+=potion=draught_of_rampant_abandon_1
profileset."Draught_of_Rampant_Abandon_2"+=potion=draught_of_rampant_abandon_2

profileset."Lights_Potential_1"+=potion=lights_potential_1
profileset."Lights_Potential_2"+=potion=lights_potential_2

profileset."Potion_of_Recklessness_1"+=potion=potion_of_recklessness_1
profileset."Potion_of_Recklessness_2"+=potion=potion_of_recklessness_2

profileset."Potion_of_Zealotry_1"+=potion=potion_of_zealotry_1
profileset."Potion_of_Zealotry_2"+=potion=potion_of_zealotry_2

# Flask + Potion Combos
## Tempered Flasks make Tempered Potion weaker
profileset."Flask_of_Alchemical_Chaos_3-Tempered_Potion_3"+=flask=flask_of_alchemical_chaos_3
profileset."Flask_of_Alchemical_Chaos_3-Tempered_Potion_3"+=potion=tempered_potion_3

profileset."Flask_of_Tempered_Aggression_3-Tempered_Potion_3"+=flask=flask_of_tempered_aggression_3
profileset."Flask_of_Tempered_Aggression_3-Tempered_Potion_3"+=potion=tempered_potion_3

profileset."Flask_of_Tempered_Mastery_3-Tempered_Potion_3"+=flask=flask_of_tempered_mastery_3
profileset."Flask_of_Tempered_Mastery_3-Tempered_Potion_3"+=potion=tempered_potion_3

profileset."Flask_of_Tempered_Swiftness_3-Tempered_Potion_3"+=flask=flask_of_tempered_swiftness_3
profileset."Flask_of_Tempered_Swiftness_3-Tempered_Potion_3"+=potion=tempered_potion_3

profileset."Flask_of_Tempered_Versatility_3-Tempered_Potion_3"+=flask=flask_of_tempered_versatility_3
profileset."Flask_of_Tempered_Versatility_3-Tempered_Potion_3"+=potion=tempered_potion_3

profileset."Flask_of_Alchemical_Chaos_3-Potion_of_Unwavering_Focus_3"+=flask=flask_of_alchemical_chaos_3
profileset."Flask_of_Alchemical_Chaos_3-Potion_of_Unwavering_Focus_3"+=potion=potion_of_unwavering_focus_3

profileset."Flask_of_Tempered_Aggression_3-Potion_of_Unwavering_Focus_3"+=flask=flask_of_tempered_aggression_3
profileset."Flask_of_Tempered_Aggression_3-Potion_of_Unwavering_Focus_3"+=potion=potion_of_unwavering_focus_3

profileset."Flask_of_Tempered_Mastery_3-Potion_of_Unwavering_Focus_3"+=flask=flask_of_tempered_mastery_3
profileset."Flask_of_Tempered_Mastery_3-Potion_of_Unwavering_Focus_3"+=potion=potion_of_unwavering_focus_3

profileset."Flask_of_Tempered_Swiftness_3-Potion_of_Unwavering_Focus_3"+=flask=flask_of_tempered_swiftness_3
profileset."Flask_of_Tempered_Swiftness_3-Potion_of_Unwavering_Focus_3"+=potion=potion_of_unwavering_focus_3

profileset."Flask_of_Tempered_Versatility_3-Potion_of_Unwavering_Focus_3"+=flask=flask_of_tempered_versatility_3
profileset."Flask_of_Tempered_Versatility_3-Potion_of_Unwavering_Focus_3"+=potion=potion_of_unwavering_focus_3